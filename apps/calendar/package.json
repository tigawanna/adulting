{
  "name": "calendar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --port 3061",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3061",
    "start": "tsx server/index.ts",
    "check-types": "tsc --noEmit",
    "db:init": "tsx scripts/db-init.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@libsql/client": "^0.18.0",
    "@tanstack/react-router": "^1.170.46",
    "hono": "^4.13.19",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.8"
  }
}
