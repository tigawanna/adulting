# ── Calendar API / database ────────────────────────────────────────────────
# Local development uses a SQLite file by default. No credentials needed.
DATABASE_URL=file:./data/calendar.db

# When moving to Turso, set both values and restart the API server:
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# Port the Hono API listens on. Vite proxies /api to this port.
PORT=3161

# Comma-separated list of allowed browser origins for direct (non-proxied) use.
CORS_ORIGIN=http://localhost:3061

# ── Future: natural-language search (embeddings) ───────────────────────────
# Reserved for the embedding provider scaffold in server/embeddings.ts.
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
