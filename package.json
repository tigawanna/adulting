{
  "name": "kenya-tools",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:calendar": "pnpm --filter calendar dev",
    "dev:calc": "pnpm --filter calc-paye-kenya dev",
    "dev:rate": "pnpm --filter rate-calculator dev",
    "lint": "vp lint --deny-warnings .",
    "lint:fix": "vp lint --fix .",
    "format": "vp fmt . --check",
    "format:fix": "vp fmt . --write",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "quality": "turbo run //#lint //#format",
    "quality:fix": "turbo run //#lint:fix //#format:fix",
    "calendar:seed": "pnpm --filter calendar seed",
    "calendar:db:init": "pnpm --filter calendar db:init",
    "prepare": "vp config && git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.0",
    "@tanstack/intent": "^0.5.5",
    "@typescript/native-preview": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "minimumReleaseAgeExclude": [
      "event-sourced-collection"
    ]
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}
